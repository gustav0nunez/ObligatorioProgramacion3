@model ObligatorioGustavoNunez.Dominio.Entities.Vehiculo


<h2>Eliminar Vehículo</h2>
<h3 class="text-danger">¿Estás seguro de que querés dar de baja este vehículo?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Matrícula</dt>
        <dd class="col-sm-10">@Model.Matricula</dd>

        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">@Model.Marca</dd>

        <dt class="col-sm-2">Modelo</dt>
        <dd class="col-sm-10">@Model.Modelo</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>