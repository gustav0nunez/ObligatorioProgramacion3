@model IEnumerable<ObligatorioGustavoNunez.Dominio.Entities.Vehiculo>


@if (TempData["Exito"] != null)
{
    <div class="alert alert-warning">
        @TempData["Exito"]
    </div>
}

<h2>Lista de Vehículos</h2>


<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Vehículo</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Matrícula</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Capacidad</th>
            <th>Precio Diario</th>
            <th>Estado</th>
            <th>Acciones</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Matricula</td>
                <td>@v.Marca</td>
                <td>@v.Modelo</td>
                <td>@v.CapacidadPasajeros</td>
                <td>$@v.PrecioDiario</td>
                <td>@v.Estado</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>