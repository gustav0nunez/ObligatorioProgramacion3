@model ObligatorioGustavoNunez.Dominio.Entities.Vehiculo


<h2>Editar Vehículo</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Matricula" class="control-label"></label>
        <input asp-for="Matricula" class="form-control" />
        <span asp-validation-for="Matricula" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Marca" class="control-label"></label>
        <input asp-for="Marca" class="form-control" />
        <span asp-validation-for="Marca" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Modelo" class="control-label"></label>
        <input asp-for="Modelo" class="form-control" />
        <span asp-validation-for="Modelo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CapacidadPasajeros" class="control-label">Capacidad de Pasajeros</label>
        <input asp-for="CapacidadPasajeros" class="form-control" type="number" />
        <span asp-validation-for="CapacidadPasajeros" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrecioDiario" class="control-label">Precio Diario</label>
        <input asp-for="PrecioDiario" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="PrecioDiario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<ObligatorioGustavoNunez.Dominio.Entities.EstadoVehiculo>()">
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>