@model IEnumerable<ObligatorioGustavoNunez.Dominio.Entities.Reserva>

<h2>Listado de Reservas</h2>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Vehículo</th>
            <th>Usuario</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@(item.Vehiculo != null ? item.Vehiculo.Matricula : "N/A")</td>
                <td>@item.Usuario?.Email</td>
                <td>@item.FechaInicio.ToShortDateString()</td>
                <td>@item.FechaFin.ToShortDateString()</td>
                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                <td>
                    <form asp-action="CambiarEstado" method="post" style="display:inline-block; margin-right: 5px;">
                        <input type="hidden" name="id" value="@item.Id" />

                        @if (item.Estado == ObligatorioGustavoNunez.Dominio.Entities.EstadoReserva.Pendiente)
                        {
                            <button type="submit" name="nuevoEstado" value="Confirmada" class="btn btn-success btn-sm">Confirmar</button>
                            <button type="submit" name="nuevoEstado" value="Cancelada" class="btn btn-secondary btn-sm">Cancelar</button>
                        }
                        else if (item.Estado == ObligatorioGustavoNunez.Dominio.Entities.EstadoReserva.Confirmada)
                        {
                            <button type="submit" name="nuevoEstado" value="EnCurso" class="btn btn-info btn-sm">Iniciar</button>
                            <button type="submit" name="nuevoEstado" value="Cancelada" class="btn btn-secondary btn-sm">Cancelar</button>
                        }
                        else if (item.Estado == ObligatorioGustavoNunez.Dominio.Entities.EstadoReserva.EnCurso)
                        {
                            <button type="submit" name="nuevoEstado" value="Completada" class="btn btn-primary btn-sm">Completar</button>
                        }
                    </form>

                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>