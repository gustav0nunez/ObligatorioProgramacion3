@model IEnumerable<ObligatorioGustavoNunez.Dominio.Entities.Reserva>

<h2>Reporte de Reservas por Fecha</h2>

<form asp-action="ReservasPorFecha" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label>Fecha Inicio:</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" required />
        </div>
        <div class="col-md-4">
            <label>Fecha Fin:</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" required />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="ReservasPorFecha" class="btn btn-secondary ms-2">Limpiar</a>
        </div>
    </div>
</form>

@if (Model != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Matrícula</th>
                <th>Modelo</th>
                <th>Documento Cliente</th>
                <th>Nombre Cliente</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                var dias = (r.FechaFin - r.FechaInicio).Days;
                var monto = dias * r.Vehiculo.PrecioDiario;
                <tr>
                    <td>@r.Vehiculo?.Matricula</td>
                    <td>@r.Vehiculo?.Modelo</td>
                    <td>@r.Usuario?.Documento</td>
                    <td>@r.Usuario?.Nombre @r.Usuario?.Apellido</td>
                    <td>@r.FechaInicio.ToShortDateString()</td>
                    <td>@r.FechaFin.ToShortDateString()</td>
                    <td>$@monto</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="alert alert-info text-end mt-4">
        <h4>Total Recaudado: $@ViewBag.TotalRecaudado</h4>
    </div>
}